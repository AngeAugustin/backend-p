# OpenAI — remplacé par Gemini (voir GEMINI_API_KEY ci-dessous)
# OPENAI_API_KEY=

# Google Gemini — chat + embeddings (Phase 2+)
GEMINI_API_KEY=
# Optional — default: gemini-2.5-flash (gemini-2.0-flash was shut down June 2026)
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# Supabase — vector store (Phase 3+, serveur uniquement)
# ⚠️ Use the service_role key — NOT the publishable/anon key (see docs/SUPABASE_SETUP.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — client-side Supabase (not used in this project for now)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
