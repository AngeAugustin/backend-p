# Local (Postgres)
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/portfolio_api?schema=public"

# Neon (production example)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# For Prisma + Neon pooler, prefer:
# DATABASE_URL="...-pooler...?sslmode=require&pgbouncer=true"
# DIRECT_URL="...without-pooler...?sslmode=require"

AUTH_SECRET="change-me-to-a-long-random-secret"
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="admin123"
FRONTEND_URL="http://localhost:5173"
NEXT_PUBLIC_APP_URL="http://localhost:1337"
