# Neon production — use pooler URL + pgbouncer for Prisma
# ⚠️ NEVER commit real credentials. Copy to Vercel env vars only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"

# Strong random secret: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-secret"

ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

FRONTEND_URL="https://your-frontend.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-backend.vercel.app"

# Chatbot RAG (Vercel backend project — server only)
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
