generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  locale      String    @default("fr")
  slug        String
  title       String
  description String
  caseStudy   String?
  category    String    @default("web")
  featured    Boolean   @default(false)
  year        String
  stack       String?
  imageUrl    String?
  coverUrl    String?
  liveUrl     String?
  repoUrl     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, locale])
  @@index([locale, publishedAt])
}

model Article {
  id          String    @id @default(cuid())
  locale      String    @default("fr")
  slug        String
  title       String
  excerpt     String
  content     String?
  category    String    @default("frontend")
  featured    Boolean   @default(false)
  readMinutes Int       @default(5)
  date        String
  imageUrl    String?
  coverUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  views       ArticleView[]

  @@unique([slug, locale])
  @@index([locale, publishedAt])
}

model ArticleView {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  country     String?
  countryCode String?
  city        String?
  region      String?
  visitorHash String
  viewDate    String
  createdAt   DateTime @default(now())

  @@unique([articleId, visitorHash, viewDate])
  @@index([articleId, createdAt])
  @@index([articleId, country])
  @@index([articleId, city])
}

model Service {
  id           String    @id @default(cuid())
  locale       String    @default("fr")
  slug         String
  title        String
  summary      String
  tagline      String?
  overview     String?
  order        Int       @default(0)
  tags         String?
  deliverables String?
  approach     String?
  stack        String?
  idealFor     String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([slug, locale])
  @@index([locale, order])
}

model Experience {
  id          String    @id @default(cuid())
  locale      String    @default("fr")
  key         String
  role        String
  company     String
  location    String?
  period      String
  description String
  order       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key, locale])
  @@index([locale, order])
}

model Testimonial {
  id          String    @id @default(cuid())
  locale      String    @default("fr")
  key         String
  quote       String
  author      String
  role        String
  order       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key, locale])
  @@index([locale, order])
}

model Education {
  id          String    @id @default(cuid())
  locale      String    @default("fr")
  key         String
  degree      String
  school      String
  period      String
  description String
  status      String    @default("completed")
  highlight   String?
  order       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key, locale])
  @@index([locale, order])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  locale    String   @default("fr")
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model ProformaInvoice {
  id     String @id @default(cuid())
  number String @unique
  status String @default("draft")

  issuedAt   DateTime  @default(now())
  validUntil DateTime?

  clientName    String
  clientEmail   String?
  clientCompany String?
  clientPhone   String?
  clientAddress String?
  clientCity    String?
  clientCountry String?
  clientIfu     String?

  issuerName    String
  issuerTitle   String?
  issuerEmail   String
  issuerPhone   String?
  issuerAddress String?
  issuerCity    String?
  issuerCountry String?
  issuerIfu     String?
  issuerWebsite String?

  currency String  @default("XOF")
  taxRate  Decimal @default(0) @db.Decimal(5, 2)
  notes    String?

  items ProformaInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, issuedAt])
  @@index([issuedAt])
}

model ProformaInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     ProformaInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal         @db.Decimal(12, 2)
  unit        String          @default("u")
  unitPrice   Decimal         @db.Decimal(12, 2)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([invoiceId, order])
}
